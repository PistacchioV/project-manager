# Opcional. O e-mail da caixa do Outlook e informado pela tela (icone de engrenagem);
# o que for salvo la vale mais que este arquivo.

# --- servidor ---
PM_PORTA=5080
PM_DEBUG=0
# PM_DATABASE=data/project_manager.duckdb

# --- Outlook (lido pelo Outlook aberto no Windows, como no OTC Tracker; sem senha) ---
PM_MAILBOX=
PM_MAIL_FETCH_LIMIT=50
# 1 = marca como lido depois de processar
PM_MAIL_MARK_AS_READ=0

# projetos do tipo pessoa: dias para tras
PM_MAIL_LOOKBACK_DAYS=90
