# Copie para .env e ajuste. Sem .env o sistema sobe em modo DEMO.

# --- servidor ---
PM_PORTA=5080
PM_DEBUG=0
# PM_DATABASE=data/project_manager.duckdb
# cria projetos e e-mails ficticios quando o banco esta vazio
PM_SEED_DEMO=1

# --- origem dos e-mails: demo | o365 | imap ---
PM_MAIL_BACKEND=demo
PM_MAIL_FETCH_LIMIT=50
# 1 = marca como lido depois de processar (o365 exige Mail.ReadWrite)
PM_MAIL_MARK_AS_READ=0

# --- Microsoft Graph (biblioteca O365) ---
# App registrado no Entra ID com permissao de APLICATIVO Mail.Read + consentimento do admin
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=
O365_MAILBOX=projetos@suaempresa.com

# --- IMAP (Office 365) ---
# Exchange Online nao aceita mais senha: gere um token OAuth2 (escopo IMAP.AccessAsUser.All)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=
IMAP_OAUTH_TOKEN=
IMAP_PASSWORD=
