# Opcional. A conexao com o Outlook e configurada pela tela (icone de engrenagem).
# Os valores abaixo servem apenas como ponto de partida; o que for salvo na tela vale mais.

# --- servidor ---
PM_PORTA=5080
PM_DEBUG=0
# PM_DATABASE=data/project_manager.duckdb

# --- Outlook: o365 (Microsoft Graph) | imap ---
PM_MAIL_BACKEND=o365
PM_MAIL_FETCH_LIMIT=50
PM_MAIL_MARK_AS_READ=0

# Microsoft Graph: app no Entra ID com permissao de APLICATIVO Mail.Read + consentimento do admin
O365_MAILBOX=
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=

# IMAP (Office 365): token OAuth2 (escopo IMAP.AccessAsUser.All); usuario = O365_MAILBOX
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_OAUTH_TOKEN=
IMAP_PASSWORD=
